# AgentFuzz Environment Configuration
# Copy this file to .env and fill in your values.
# AgentFuzz will automatically load .env if python-dotenv is installed.

# ── LLM API (optional – only needed for --oracle llm/composite or --llm-api-key) ──
# OpenAI-compatible API key. Supports OpenAI, Azure OpenAI, Groq, Together, etc.
OPENAI_API_KEY=sk-...

# Override the API base URL to use a local model server (e.g. Ollama, vLLM, LM Studio)
# OPENAI_API_BASE=http://localhost:11434/v1

# Model to use for both the LLM Mutator and the LLM-as-a-Judge Oracle
# AGENTFUZZ_LLM_MODEL=gpt-4o-mini

# ── Fuzzing defaults (all overridable via CLI flags) ──
# AGENTFUZZ_TARGET=http://localhost:8000/chat
# AGENTFUZZ_CONCURRENCY=5
# AGENTFUZZ_TIMEOUT=30
