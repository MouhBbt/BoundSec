# BoundSec — optional environment configuration.
# Everything runs fully offline against the gym; these are only needed for live targets.
# Copy to .env (auto-loaded if python-dotenv is installed).

# OpenAI-compatible key (OpenAI, Azure, Together, local vLLM/Ollama, …)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=http://localhost:11434/v1        # e.g. Ollama / vLLM

# Groq (base URL is inferred automatically when this is set)
# GROQ_API_KEY=gsk_...

# Model used for live targets and the LLM-judge detector
# AGENTFUZZ_LLM_MODEL=gpt-4o-mini
